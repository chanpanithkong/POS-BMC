# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# PostgreSQL (the API connects; the Next.js frontend never does)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=pims_db
# Tests migrate and write ONLY to this database. It must differ from DB_NAME and contain "test".
TEST_DB_NAME=pims_test_db
# Optional: a full URL overrides the DB_* values (used by docker-compose)
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/pims_db

# At least 32 random characters. Generate one with:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Set to true when the API is served over HTTPS
REFRESH_COOKIE_SECURE=false
