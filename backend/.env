# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# PostgreSQL (the API connects; the Next.js frontend never does)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1
DB_NAME=pims_demo_store
# Tests migrate and write ONLY to this database. It must differ from DB_NAME and contain "test".
TEST_DB_NAME=pims_demo
# Optional: a full URL overrides the DB_* values (used by docker-compose)
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/pims_db

# At least 32 random characters. Generate one with:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=4dW9HL8K447-mpo3VHtWZLR6NHFothiNlbYkCbMgeLNb6S0vmrpOtgEeP0g09h0x

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Set to true when the API is served over HTTPS
REFRESH_COOKIE_SECURE=false

# Uploaded files (product images, expense attachments). Defaults to backend/storage.
# STORAGE_DIR=

# Password-reset email (optional). Without SMTP_HOST the worker keeps emails queued.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_STARTTLS=true
# Link used in reset emails
FRONTEND_URL=http://localhost:3000
