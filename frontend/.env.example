# Base URL of the FastAPI backend (used when NEXT_PUBLIC_API_MODE=live)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# "live" (the default) calls the backend above. "mock" runs the screens on built-in
# sample data with no backend at all, for a quick look only.
NEXT_PUBLIC_API_MODE=live

# Simulated network latency for mock requests, in milliseconds
NEXT_PUBLIC_MOCK_LATENCY_MS=60
